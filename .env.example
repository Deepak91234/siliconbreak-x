# Copy to .env and fill in. .env is git-ignored and read only by the backend.

# --- LLM (runtime AI agent). Without a key CircuitLoop runs with the offline rule-based
# --- interpreter and preverified template generators, and labels every result accordingly.
ANTHROPIC_API_KEY=
CIRCUITLOOP_LLM_PROVIDER=anthropic
CIRCUITLOOP_LLM_MODEL=claude-opus-5-5

# --- Existing Vivado installation (cse100-vivado-on-silicon-mac). Defaults shown.
# CIRCUITLOOP_VIVADO_HOST_ROOT=~/cse100/cse100-vivado-on-silicon-mac-main
# CIRCUITLOOP_VIVADO_CONTAINER=vivado_container
# CIRCUITLOOP_VIVADO_HEADLESS_CONTAINER=circuitloop_vivado
# CIRCUITLOOP_VIVADO_IMAGE=x64-linux
# CIRCUITLOOP_VIVADO_WORKSPACE_SUBDIR=circuitloop_ws
# CIRCUITLOOP_VIVADO_VERSION=          # auto-detected (2023.2)
# CIRCUITLOOP_VIVADO_BUILD_TIMEOUT_S=2400
# CIRCUITLOOP_VIVADO_MAX_THREADS=4

# --- Simulation
# CIRCUITLOOP_SIM_CLK_HZ=10000         # accelerated clock used for Verilator tests
# CIRCUITLOOP_MAX_REPAIR_ATTEMPTS=3

# --- Server
# CIRCUITLOOP_HOST=127.0.0.1
# CIRCUITLOOP_PORT=8000

# --- SiliconBreak X (hardware-security audits). All keys stay in the backend process.
# BITDEER_API_KEY=                      # Bitdeer Model Studio (preferred investigator)
# BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
# BITDEER_MODEL=zai-org/GLM-5.3
# FACTORY_API_KEY=                      # Factory Droid repair agent (needs the `droid` CLI on PATH)
# SILICONBREAK_DROID=                   # path to the droid CLI if it is not on PATH
# SILICONBREAK_DROID_MODEL=             # optional Droid model id
# SILICONBREAK_INVESTIGATOR=auto        # auto | bitdeer | anthropic | rules
# SILICONBREAK_REPAIR_MODEL=auto        # provider for model-patch repairs: auto | bitdeer | anthropic

# --- Optional isolated Vivado layout (keeps builds away from the folder your own Vivado work uses).
# The install is mounted read-only at <container home>/Xilinx; HOST_ROOT is a dedicated writable folder.
# CIRCUITLOOP_VIVADO_CONTAINER=siliconbreak_vivado
# CIRCUITLOOP_VIVADO_HEADLESS_CONTAINER=siliconbreak_vivado
# CIRCUITLOOP_VIVADO_HOST_ROOT=~/siliconbreak_vivado
# CIRCUITLOOP_VIVADO_INSTALL_DIR=~/cse100/cse100-vivado-on-silicon-mac-main/Xilinx
# CIRCUITLOOP_VIVADO_WORKSPACE_SUBDIR=ws
# CIRCUITLOOP_VIVADO_MAX_THREADS=2
# CIRCUITLOOP_VIVADO_MEMORY=2560m
# CIRCUITLOOP_VIVADO_CPUS=3

# --- AI credit protection (live AI calls stay off until turned on in the dashboard)
# SILICONBREAK_LIVE_AI=off
# SILICONBREAK_BUDGET_ANTHROPIC_USD=40
# SILICONBREAK_BUDGET_BITDEER_USD=40
# SILICONBREAK_BUDGET_DAILY_USD=15
# SILICONBREAK_BUDGET_PER_CALL_USD=1.0
# SILICONBREAK_BITDEER_PRICE_IN=1.0        # USD per 1M tokens (high placeholder)
# SILICONBREAK_BITDEER_PRICE_OUT=4.0
# SILICONBREAK_DROID_SESSIONS_PER_DAY=6
# SILICONBREAK_DROID_MAX_ATTEMPTS=2

# Copy to .env and fill in. .env is git-ignored and read only by the backend.

# --- LLM (runtime AI agent). Without a key CircuitLoop runs with the offline rule-based
# --- interpreter and preverified template generators, and labels every result accordingly.
ANTHROPIC_API_KEY=
CIRCUITLOOP_LLM_PROVIDER=anthropic
CIRCUITLOOP_LLM_MODEL=claude-opus-5-5

# --- Existing Vivado installation (cse100-vivado-on-silicon-mac). Defaults shown.
# CIRCUITLOOP_VIVADO_HOST_ROOT=~/cse100/cse100-vivado-on-silicon-mac-main
# CIRCUITLOOP_VIVADO_CONTAINER=vivado_container
# CIRCUITLOOP_VIVADO_HEADLESS_CONTAINER=circuitloop_vivado
# CIRCUITLOOP_VIVADO_IMAGE=x64-linux
# CIRCUITLOOP_VIVADO_WORKSPACE_SUBDIR=circuitloop_ws
# CIRCUITLOOP_VIVADO_VERSION=          # auto-detected (2023.2)
# CIRCUITLOOP_VIVADO_BUILD_TIMEOUT_S=2400
# CIRCUITLOOP_VIVADO_MAX_THREADS=4

# --- Simulation
# CIRCUITLOOP_SIM_CLK_HZ=10000         # accelerated clock used for Verilator tests
# CIRCUITLOOP_MAX_REPAIR_ATTEMPTS=3

# --- Server
# CIRCUITLOOP_HOST=127.0.0.1
# CIRCUITLOOP_PORT=8000
